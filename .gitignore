# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# pytest / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Verification-suite output (regenerated by tests/*.py, see README.md).
# figures/hierarchy_diagrams/ is NOT generated output -- it's committed,
# curated diagram assets referenced by README.md -- so it's re-included.
/figures/*
!/figures/hierarchy_diagrams/

# Editors / OS
.vscode/
.idea/
.DS_Store

# Claude Code local state (permissions, session locks) -- no shared
# CLAUDE.md or commands/agents here worth tracking.
.claude/
